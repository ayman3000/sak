# Copy to ~/.config/sak/.env (all projects) or ./.env (one project) and fill in
# the keys you use. A real environment variable always wins over these files.

# Default provider and model (ollama, anthropic, openai, gemini, openrouter).
# /model and /provider in the chat override these and are remembered.
SAK_PROVIDER=ollama
SAK_MODEL=kimi-k2.6:cloud

# Cloud providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Web search — https://tavily.com
TAVILY_API_KEY=

# Ollama server, if not localhost:11434
# OLLAMA_HOST=192.168.1.20:11434
